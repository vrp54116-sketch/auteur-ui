{
  "name": "auteur-ui",
  "version": "0.1.0",
  "description": "Design taste compiler for AI coding agents",
  "main": "dist/packages/cli/index.js",
  "bin": {
    "auteur-ui": "./bin/auteur-ui.mjs"
  },
  "files": [
    "bin",
    "dist/packages",
    "dist/scripts",
    "code",
    "looks",
    "modules",
    "skill",
    "rules.json",
    "advisory.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "budget": "tsc && node dist/scripts/budget.js",
    "eval:dry": "node evals/run.mjs --clean --arm baseline --task all --seeds 3 --dry-run && node evals/report.mjs"
  },
  "keywords": [
    "ai",
    "design",
    "taste",
    "agents",
    "claude",
    "cursor",
    "ui"
  ],
  "author": "auteur-ui contributors",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "gpt-tokenizer": "^4.1.2",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  }
}
