{
  "look": "terminal-luxe",
  "version": "0.1.0",
  "type": {
    "display": "ui-monospace, Menlo, monospace",
    "text": "ui-monospace, Menlo, monospace",
    "mono": "ui-monospace, monospace",
    "scale": 1.25,
    "opticalSizing": "auto"
  },
  "palette": {
    "id": "crt-phosphor",
    "mode": "dark",
    "tokens": {
      "bg": "oklch(0.18 0.02 240)",
      "surface": "oklch(0.22 0.02 240)",
      "border": "oklch(0.35 0.03 240)",
      "fg": "oklch(0.92 0.02 142)",
      "fgMuted": "oklch(0.65 0.04 142)",
      "accent": "oklch(0.85 0.22 142)"
    }
  },
  "space": {
    "base": 4,
    "rhythm": "dense"
  },
  "radius": {
    "strategy": "sharp",
    "values": {
      "card": "0px",
      "button": "0px",
      "input": "0px",
      "badge": "0px"
    }
  },
  "motion": {
    "personality": "restrained",
    "ease": "cubic-bezier(0.16, 1, 0.3, 1)",
    "dur": [100, 180, 240],
    "stagger": 20
  },
  "sound": {
    "kit": "minimal-click",
    "events": ["play", "pause", "seek"],
    "volume": 0.25,
    "enabled": true
  },
  "layout": {
    "grid": "dense-12",
    "asymmetry": 0.2
  },
  "forbid": [
    "purple-blue-gradient",
    "centered-hero-3-cards",
    "emoji-icons",
    "diffuse-drop-shadows",
    "inter-roboto-default"
  ]
}
