{
  "id": "terminal-luxe",
  "name": "Terminal Luxe",
  "description": "Developer-centric monospace interface with CRT-inspired palette, phosphor accents, and character-cell grid.",
  "type": {
    "display": "JetBrains Mono",
    "text": "JetBrains Mono",
    "mono": "JetBrains Mono",
    "scale": 1.125,
    "opticalSizing": false
  },
  "palette": {
    "id": "terminal-phosphor",
    "mode": "dark",
    "tokens": {
      "bg": "oklch(0.12 0.005 130)",
      "surface": "oklch(0.16 0.008 130)",
      "border": "oklch(0.28 0.015 130)",
      "fg": "oklch(0.92 0.03 130)",
      "fgMuted": "oklch(0.68 0.04 130)",
      "accent": "oklch(0.85 0.22 142)"
    }
  },
  "space": {
    "base": 4,
    "rhythm": "terminal-grid"
  },
  "radius": {
    "strategy": "sharp",
    "values": {
      "none": "0px",
      "sm": "2px",
      "md": "3px",
      "lg": "4px",
      "full": "0px"
    }
  },
  "motion": {
    "personality": "restrained",
    "ease": "steps(4, jump-end)",
    "dur": [50, 100, 200],
    "stagger": 10
  },
  "sound": {
    "kit": "amber-relay",
    "events": ["keystroke", "execute", "alert"],
    "volume": 0.2,
    "enabled": false
  },
  "layout": {
    "grid": "character-cell",
    "asymmetry": 0.05
  },
  "forbid": [
    "proportional-sans-serif",
    "smooth-spring-physics",
    "large-border-radius",
    "glassmorphism",
    "pastel-colors"
  ],
  "version": "0.1.0"
}

